# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Cron auth: any long random string, set the same value in Vercel + GitHub secret
CRON_SECRET=

# Comma-separated Supabase auth user ids allowed into /admin
ADMIN_USER_IDS=

# Public site URL (Vercel production URL, or http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lichess OAuth public client id (no secret, PKCE). Any stable string works.
LICHESS_CLIENT_ID=woodpushers-web

# Scraper cost guard
MAX_CITIES_PER_RUN=10

# Optional: Google Places enrichment (phone, hours, rating, photo, maps link).
# Leave empty to disable. See docs/GOOGLE_PLACES.md before enabling.
GOOGLE_MAPS_API_KEY=
